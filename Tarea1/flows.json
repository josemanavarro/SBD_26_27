    {
        "id": "e1c7c2f98a39d7c9",
        "type": "function",
        "z": "6c64554957e0e3ce",
        "name": "function 3",
        "func": "let raw = msg.payload;\nlet aula = msg.topic || \"Desconocida\";\n\n// Reemplazar coma por punto si es un string\nif (typeof raw === \"string\") {\n    raw = raw.replace(',', '.').trim();\n}\n\nlet lectura = Number(raw);\n\nlet esValido = lectura !== null && typeof lectura !== \"boolean\" && !isNaN(lectura);\n\nif (esValido==true) {\n\n    msg.payload = {\n        ubicacion: aula,\n        celsius: Number(lectura.toFixed(2)),\n        fahrenheit: Number((((lectura * 9)/5)+32).toFixed(2)),\n        kelvin: Number((lectura + 273.15).toFixed(2)),\n        timestamp: new Date().toISOString(),\n        origen: \"Node-RED\",\n        valido: esValido\n    };\n} else {\n    msg.payload = {\n        ubicacion: aula,\n        celsius: null,\n        fahrenheit: null,\n        kelvin: null,\n        timestamp: new Date().toISOString(),\n        origen: \"Node-RED\",\n        valido: esValido        \n    };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 240,
        "wires": [
