    {
        "id": "991aa1134a12d6df",
        "type": "function",
        "z": "6c64554957e0e3ce",
        "name": "function 4",
        "func": "let contador = context.get(\"contador\") || 0;\ncontador = contador + 1;\nlet medida = msg.payload;\n\nlet lista = context.get(\"historico\") || [];\nlista.push({\n    orden: contador,\n    valor: msg.payload,\n    hora: new Date().toLocaleTimeString()\n});\n\ncontext.set(\"contador\", contador);\ncontext.set(\"historico\",lista);\n\nmsg.payload = {\n    mensajeActual: msg.payload,\n    ejecuciones: contador,\n    ultimos: lista.slice(-3)\n};\n\nif (isNaN(medida)){\n    return {[\"ERROR\"]:[msg] }\n}\n\nreturn msg;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// El código añadido aquí se ejecutará una vez\n// cuando el nodo es iniciado.\ncontext.set(\"contador\", 0);\ncontext.set(\"historico\", []);",
        "finalize": "",
